# Copy this file to .env for local development. Do not commit real credentials.
# These values are only for local development; they are not production settings.
COMPOSE_PROJECT_NAME=restaurant-os-dev
POSTGRES_IMAGE=postgres:17
POSTGRES_DB=restaurant_dev
POSTGRES_USER=restaurant_dev
POSTGRES_PASSWORD=<define-a-local-development-secret>
POSTGRES_PORT=5433

# API only binds to loopback until LAN TLS, RBAC, and device provisioning exist.
API_HOST=127.0.0.1
API_PORT=3000
API_EXECUTION_MODE=development
API_BODY_LIMIT_BYTES=65536
# Comma-separated HTTP(S) origins. Empty disables CORS. Do not use *.
API_ALLOWED_ORIGINS=

# Socket.IO usa el mismo listado por defecto. Si se define, sustituye API_ALLOWED_ORIGINS.
# Los clientes nativos sin encabezado Origin se autentican igualmente por sesión; los orígenes web requieren esta lista.
API_WS_ALLOWED_ORIGINS=
API_WS_MAX_CONNECTIONS=100
API_WS_MAX_MESSAGE_BYTES=16384
API_WS_SESSION_REVALIDATION_SECONDS=60
API_WS_PING_INTERVAL_MS=25000
API_WS_PING_TIMEOUT_MS=20000

# Mantener false hasta que el propietario autorice explícitamente una exposición LAN.
# TLS exige rutas locales, privadas y no versionadas; no añadir certificados al repositorio.
API_LAN_EXPOSURE_AUTHORIZED=false
API_TLS_ENABLED=false
API_TLS_KEY_PATH=
API_TLS_CERT_PATH=

# Sesiones opacas locales: no incluir secretos ni tokens aquí.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_LOGIN_ATTEMPT_LIMIT=5
AUTH_LOGIN_ATTEMPT_WINDOW_SECONDS=900

# PostgreSQL nativo para Prisma. Definir DATABASE_URL solamente en
# .env.database con la cuenta de aplicación; consulte docs/database/MIGRACIONES.md.
DATABASE_URL=<set-only-in-.env.database>
