# Copy this file to .env for local development. Do not commit real credentials.
POSTGRES_DB=restaurant_dev
POSTGRES_USER=restaurant_dev
POSTGRES_PASSWORD=<define-a-local-development-secret>
POSTGRES_PORT=5433

# API only binds to loopback until LAN TLS, RBAC, and device provisioning exist.
API_HOST=127.0.0.1
API_PORT=3000
