# Copy this file to .env for local development. Do not commit real credentials.
# These values are only for local development; they are not production settings.
COMPOSE_PROJECT_NAME=restaurant-os-dev
POSTGRES_IMAGE=postgres:17
POSTGRES_DB=restaurant_dev
POSTGRES_USER=restaurant_dev
POSTGRES_PASSWORD=<define-a-local-development-secret>
POSTGRES_PORT=5433

# API only binds to loopback until LAN TLS, RBAC, and device provisioning exist.
API_HOST=127.0.0.1
API_PORT=3000
API_EXECUTION_MODE=development
# Comma-separated HTTP(S) origins. Empty disables CORS. Do not use *.
API_ALLOWED_ORIGINS=

# PostgreSQL nativo para Prisma. Definir DATABASE_URL solamente en
# .env.database con la cuenta de aplicación; consulte docs/database/MIGRACIONES.md.
DATABASE_URL=<set-only-in-.env.database>
