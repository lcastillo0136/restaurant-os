generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum LifecycleStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RoleScope {
  ORGANIZATION
  BRANCH
}
enum EmploymentStatus {
  ACTIVE
  INACTIVE
}
enum AssignmentStatus {
  ACTIVE
  INACTIVE
  CANCELED
}
enum WorkShiftStatus {
  SCHEDULED
  CANCELED
}
enum TableStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  RESERVED
  BLOCKED
  OUT_OF_SERVICE
}
enum TableSessionStatus {
  OPEN
  CLOSED
}

model Organization {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique @db.VarChar(64)
  displayName String          @map("display_name") @db.VarChar(160)
  status      LifecycleStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  branches    Branch[]
  userRoles   UserRole[]
  auditEvents AuditEvent[]
  securityAuditEvents SecurityAuditEvent[]
  employees Employee[]
  workShifts WorkShift[]
  areas Area[]
  diningTables DiningTable[]
  tableSessions TableSession[]

  @@map("organizations")
}

model Branch {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  code           String          @db.VarChar(64)
  displayName    String          @map("display_name") @db.VarChar(160)
  timeZone       String          @default("America/Mexico_City") @map("time_zone") @db.VarChar(64)
  status         LifecycleStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles      UserRole[]
  auditEvents    AuditEvent[]
  securityAuditEvents SecurityAuditEvent[]
  employeeAssignments EmployeeBranchAssignment[]
  workShifts WorkShift[]
  areas Area[]
  diningTables DiningTable[]
  tableSessions TableSession[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("branches")
}

model AppUser {
  id              String       @id @default(uuid()) @db.Uuid
  identitySource  String       @map("identity_source") @db.VarChar(64)
  identitySubject String       @map("identity_subject") @db.VarChar(160)
  displayName     String?      @map("display_name") @db.VarChar(160)
  status          UserStatus   @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles       UserRole[]
  auditEvents     AuditEvent[]
  credential      UserCredential?
  authSessions    AuthSession[]
  securityAuditEvents SecurityAuditEvent[]
  employee Employee?

  @@unique([identitySource, identitySubject])
  @@index([status])
  @@map("users")
}

model Employee {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 employeeCode String @map("employee_code") @db.VarChar(64)
 displayName String @map("display_name") @db.VarChar(160)
 status EmploymentStatus @default(ACTIVE)
 userId String? @unique @map("user_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 user AppUser? @relation(fields:[userId],references:[id],onDelete:Restrict)
 branchAssignments EmployeeBranchAssignment[]
 shiftAssignments WorkShiftAssignment[]
 @@unique([organizationId, employeeCode])
  @@unique([id, organizationId])
 @@index([organizationId,status])
 @@map("employees")
}
model EmployeeBranchAssignment {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 employeeId String @map("employee_id") @db.Uuid
 branchId String @map("branch_id") @db.Uuid
 status AssignmentStatus @default(ACTIVE)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
 employee Employee @relation(fields:[employeeId,organizationId],references:[id,organizationId],onDelete:Restrict)
 branch Branch @relation(fields:[branchId,organizationId],references:[id,organizationId],onDelete:Restrict)
 @@unique([employeeId,branchId])
 @@index([organizationId,branchId,status])
 @@map("employee_branch_assignments")
}
model WorkShift {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 branchId String @map("branch_id") @db.Uuid
 scheduledStart DateTime @map("scheduled_start") @db.Timestamptz(6)
 scheduledEnd DateTime @map("scheduled_end") @db.Timestamptz(6)
 status WorkShiftStatus @default(SCHEDULED)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 branch Branch @relation(fields:[branchId,organizationId],references:[id,organizationId],onDelete:Restrict)
 assignments WorkShiftAssignment[]
 @@unique([id,organizationId,branchId])
 @@index([organizationId,branchId,scheduledStart])
 @@map("work_shifts")
}
model WorkShiftAssignment {
 id String @id @default(uuid()) @db.Uuid
 workShiftId String @map("work_shift_id") @db.Uuid
 employeeId String @map("employee_id") @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 branchId String @map("branch_id") @db.Uuid
 status AssignmentStatus @default(ACTIVE)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
 workShift WorkShift @relation(fields:[workShiftId,organizationId,branchId],references:[id,organizationId,branchId],onDelete:Restrict)
 employee Employee @relation(fields:[employeeId,organizationId],references:[id,organizationId],onDelete:Restrict)
 @@unique([workShiftId,employeeId])
 @@map("work_shift_assignments")
}
model Area {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 branchId String @map("branch_id") @db.Uuid
 code String @db.VarChar(64)
 displayName String @map("display_name") @db.VarChar(160)
 status LifecycleStatus @default(ACTIVE)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 branch Branch @relation(fields:[branchId,organizationId],references:[id,organizationId],onDelete:Restrict)
 diningTables DiningTable[]
 @@unique([organizationId,branchId,code])
 @@unique([id,organizationId,branchId])
 @@index([organizationId,branchId,status])
 @@map("areas")
}
model DiningTable {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 branchId String @map("branch_id") @db.Uuid
 areaId String @map("area_id") @db.Uuid
 code String @db.VarChar(64)
 capacity Int
 status TableStatus @default(AVAILABLE)
 deviceId String? @map("device_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 branch Branch @relation(fields:[branchId,organizationId],references:[id,organizationId],onDelete:Restrict)
 area Area @relation(fields:[areaId,organizationId,branchId],references:[id,organizationId,branchId],onDelete:Restrict)
 sessions TableSession[]
 @@unique([organizationId,branchId,code])
 @@unique([id,organizationId,branchId])
 @@index([organizationId,branchId,status])
 @@index([areaId])
 @@map("dining_tables")
}
model TableSession {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 branchId String @map("branch_id") @db.Uuid
 tableId String @map("table_id") @db.Uuid
 openedAt DateTime @default(now()) @map("opened_at") @db.Timestamptz(6)
 closedAt DateTime? @map("closed_at") @db.Timestamptz(6)
 status TableSessionStatus @default(OPEN)
 version Int @default(1)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict)
 branch Branch @relation(fields:[branchId,organizationId],references:[id,organizationId],onDelete:Restrict)
 diningTable DiningTable @relation(fields:[tableId,organizationId,branchId],references:[id,organizationId,branchId],onDelete:Restrict)
 @@index([organizationId,branchId,tableId,status])
 @@map("table_sessions")
}

model UserCredential {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  passwordHash    String   @map("password_hash") @db.VarChar(512)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            AppUser  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_credentials")
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  accessTokenHash   String    @unique @map("access_token_hash") @db.Char(64)
  accessExpiresAt   DateTime  @map("access_expires_at") @db.Timestamptz(6)
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.Char(64)
  refreshExpiresAt  DateTime  @map("refresh_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([accessExpiresAt])
  @@index([refreshExpiresAt])
  @@map("auth_sessions")
}

model SecurityAuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  branchId       String?      @map("branch_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(96)
  result         String       @db.VarChar(24)
  requestId      String?      @map("request_id") @db.VarChar(64)
  metadata       Json         @default("{}") @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actorUser      AppUser?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([eventType, createdAt])
  @@map("security_audit_events")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(64)
  displayName String           @map("display_name") @db.VarChar(120)
  status      LifecycleStatus  @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(96)
  description String?          @db.VarChar(240)
  status      LifecycleStatus  @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  scope          RoleScope    @default(BRANCH)
  branchId       String?      @map("branch_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           AppUser      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([userId, branchId])
  @@index([roleId, branchId])
  @@index([organizationId, userId, branchId])
  @@map("user_roles")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String?      @map("branch_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(96)
  entityType     String       @map("entity_type") @db.VarChar(96)
  entityId       String       @map("entity_id") @db.Uuid
  metadata       Json         @default("{}") @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actorUser      AppUser?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([branchId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}
